{
  "name": "jitter-editor",
  "version": "1.0.0",
  "description": "Fast, distraction-free code editor for PC, Mac, and Chromebook",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jitter.editor",
    "productName": "JitterDev",
    "icon": "icon.png",
    "files": [
      "main.js",
      "app.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "Jitter-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "artifactName": "Jitter-Mac.${ext}"
    },
    "linux": {
      "target": "deb",
      "icon": "icon.png",
      "category": "Development",
      "artifactName": "Jitter-Chromebook.${ext}"
    }
  }
}
